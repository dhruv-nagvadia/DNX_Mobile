               scriptText = "set -e&#10;TARGET_ENV=&quot;staging&quot;&#10;PORT=8081&#10;MARKER=/tmp/dnx-metro-env&#10;&#10;if lsof -ti:$PORT &gt;/dev/null 2&gt;&amp;1 &amp;&amp; [ &quot;$(cat &quot;$MARKER&quot; 2&gt;/dev/null)&quot; = &quot;$TARGET_ENV&quot; ]; then&#10;  echo &quot;Metro already running for $TARGET_ENV — reusing.&quot;&#10;  exit 0&#10;fi&#10;&#10;echo &quot;Switching Metro to $TARGET_ENV...&quot;&#10;lsof -ti:$PORT | xargs -r kill -9 || true&#10;cd &quot;$SRCROOT/..&quot;&#10;echo &quot;$TARGET_ENV&quot; &gt; &quot;$MARKER&quot;&#10;(APP_ENV=$TARGET_ENV npx react-native start --reset-cache &gt; /tmp/dnx-metro-$TARGET_ENV.log 2&gt;&amp;1 &amp;)&#10;&#10;for i in $(seq 1 30); do&#10;  if curl -s -o /dev/null &quot;http://localhost:$PORT/status&quot;; then&#10;    echo &quot;Metro ($TARGET_ENV) is ready.&quot;&#10;    exit 0&#10;  fi&#10;  sleep 1&#10;done&#10;echo &quot;warning: Metro did not become ready within 30s — check /tmp/dnx-metro-$TARGET_ENV.log&quot; &gt;&amp;2&#10;">
