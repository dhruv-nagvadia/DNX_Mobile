{
  "name": "dnx-provider-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "DNX Provider - mobile app for providers to manage their business (React Native CLI + RTK Query)",
  "scripts": {
    "start": "APP_ENV=development react-native start --reset-cache",
    "start:dev": "APP_ENV=development react-native start --reset-cache",
    "start:staging": "APP_ENV=staging react-native start --reset-cache",
    "start:production": "APP_ENV=production react-native start --reset-cache",
    "android": "(adb reverse tcp:4000 tcp:4000 >/dev/null 2>&1 || true) && APP_ENV=development react-native run-android",
    "android:dev": "(adb reverse tcp:4000 tcp:4000 >/dev/null 2>&1 || true) && APP_ENV=development react-native run-android",
    "android:staging": "(adb reverse tcp:4001 tcp:4001 >/dev/null 2>&1 || true) && APP_ENV=staging react-native run-android",
    "android:production": "(adb reverse tcp:4002 tcp:4002 >/dev/null 2>&1 || true) && APP_ENV=production react-native run-android",
    "ios": "APP_ENV=development react-native run-ios",
    "ios:dev": "APP_ENV=development react-native run-ios",
    "ios:staging": "APP_ENV=staging react-native run-ios",
    "ios:production": "APP_ENV=production react-native run-ios",
    "android:release:dev": "rm -rf ${TMPDIR:-/tmp}/metro-* ${TMPDIR:-/tmp}/haste-map-* && APP_ENV=development react-native run-android --mode release",
    "android:release:staging": "rm -rf ${TMPDIR:-/tmp}/metro-* ${TMPDIR:-/tmp}/haste-map-* && APP_ENV=staging react-native run-android --mode release",
    "android:release:production": "rm -rf ${TMPDIR:-/tmp}/metro-* ${TMPDIR:-/tmp}/haste-map-* && APP_ENV=production react-native run-android --mode release",
    "ios:release:dev": "rm -rf ${TMPDIR:-/tmp}/metro-* ${TMPDIR:-/tmp}/haste-map-* && APP_ENV=development react-native run-ios --mode Release",
    "ios:release:staging": "rm -rf ${TMPDIR:-/tmp}/metro-* ${TMPDIR:-/tmp}/haste-map-* && APP_ENV=staging react-native run-ios --mode Release",
    "ios:release:production": "rm -rf ${TMPDIR:-/tmp}/metro-* ${TMPDIR:-/tmp}/haste-map-* && APP_ENV=production react-native run-ios --mode Release",
    "build:android:staging": "rm -rf ${TMPDIR:-/tmp}/metro-* ${TMPDIR:-/tmp}/haste-map-* && cd android && APP_ENV=staging ./gradlew bundleRelease",
    "build:apk:staging": "rm -rf ${TMPDIR:-/tmp}/metro-* ${TMPDIR:-/tmp}/haste-map-* && cd android && APP_ENV=staging ./gradlew assembleRelease",
    "build:android:production": "rm -rf ${TMPDIR:-/tmp}/metro-* ${TMPDIR:-/tmp}/haste-map-* && cd android && APP_ENV=production ./gradlew bundleRelease",
    "build:apk:production": "rm -rf ${TMPDIR:-/tmp}/metro-* ${TMPDIR:-/tmp}/haste-map-* && cd android && APP_ENV=production ./gradlew assembleRelease",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "adb:reverse": "adb reverse tcp:4000 tcp:4000 && adb reverse tcp:4001 tcp:4001 && adb reverse tcp:4002 tcp:4002 && adb reverse --list"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-native-community/geolocation": "3.4.0",
    "@react-native-firebase/app": "27.1.1",
    "@react-native-firebase/messaging": "27.1.1",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@reduxjs/toolkit": "2.14.0",
    "axios": "1.21.1",
    "lucide-react-native": "1.72.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-image-picker": "8.3.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-size-matters": "0.4.2",
    "react-native-svg": "15.16.1",
    "react-redux": "9.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.29.14",
    "@babel/runtime": "7.29.14",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "babel-jest": "29.7.0",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "3.10.1",
    "react-native-dotenv": "5.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "29.5.14"
  },
  "engines": {
    "node": ">= 20.19.4"
  }
}
