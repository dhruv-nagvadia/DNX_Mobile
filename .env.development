# Active when APP_ENV=development (npm run android:dev / ios:dev / start:dev).
#
# Physical device / Android emulator/simulator can't reach "localhost" (that's
# the device itself) — point this at your machine's current LAN IP instead.
# This changes whenever your network changes (new Wi-Fi, VPN, office vs home) —
# re-run `ipconfig getifaddr en0` and update this line if requests start
# timing out instead of connecting/erroring immediately.
API_BASE_URL=http://10.95.254.187:4000/api/v1
