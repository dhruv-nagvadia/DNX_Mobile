# `module:react-native-dotenv` (babel.config.js) reads `.env.<APP_ENV>` at
# bundle time and exposes its values via `import { API_BASE_URL } from '@env'`.
#
# APP_ENV is set by the npm script you run — android:dev/staging/production,
# ios:dev/staging/production, start:dev/staging/production (see package.json)
# — which picks between the three committed files:
#   .env.development   .env.staging   .env.production
# This file is just a reference template for creating a fourth env later.
#
# On a physical device, "localhost" means the phone, not your machine — use
# your computer's LAN IP (e.g. http://192.168.1.10:4000/api/v1). The Android
# emulator can also use 10.0.2.2 as a host alias.
API_BASE_URL=http://localhost:4000/api/v1
