# react-native-config reads this file at build time and exposes values via `Config`.
# Copy to .env (and .env.staging / .env.production as needed).
# NOTE: on a physical device, localhost points at the phone — use your machine's
# LAN IP (e.g. http://192.168.1.10:4000). Android emulator uses 10.0.2.2.
BASE_URL=http://localhost:4000/api/v1
ENV=development
